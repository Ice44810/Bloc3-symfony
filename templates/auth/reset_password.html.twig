{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe - Budget App{% endblock %}

{% block body %}
    <div class="container">
        <div class="breadcrumb mt-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Accueil</a></li>
                </ol>
            </nav>
        </div>

        <p class="mb-0 fs-4 text-black ms-3 fw-bold">Réinitialiser le mot de passe</p>
        <p class="small text-muted ms-3">Entrez votre adresse mail pour recevoir les instructions</p>

        <div class="form m-auto mt-3 ms-3">
            <div class="img-container mb-4 position-relative text-center">
                <img src="/assets/images/forgotpass.jpg" alt="Keylock Image"
                    style="width: 300px; margin-top: 70px; margin-bottom: 60px;">
            </div>

            <form class="mb-3 mx-3 mt-5" method="post" id="resetPasswordForm">
                <div class="mb-4 position-relative">
                    <label class="position-absolute px-2 ms-3 text-muted fs-6" style="top: -13px; left: 0;">
                        Email
                    </label>
                    <div class="border shadow-sm rounded-3 px-3 d-flex align-items-center" style="height: 50px;">
                        <input type="email" id="email" class="form-control small border-0 bg-transparent"
                            placeholder="votre-email@exemple.com" style="box-shadow: none;" required>
                    </div>
                </div>
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary" style="background-color: #6c5ce7; border-color: #6c5ce7;">Continuer</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // FORMULAIRE DE RÉINITIALISATION DE MOT DE PASSE 
        document.getElementById('resetPasswordForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const email = document.getElementById('email').value.trim();

            // Validation simple côté client
            if (!email) {
                alert("Veuillez entrer une adresse email.");
                return;
            }

            // Envoi des données à l'API
            try {
                const response = await fetch('/api/users/reset-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email })
                });

                // Gérer la réponse de l'API
                const data = await response.json();

                if (data.success) {
                    alert('Si cet email correspond à un compte, un lien de réinitialisation a été envoyé.');
                    window.location.href = '/login';
                } else {
                    alert(data.message || 'Erreur lors de la demande de réinitialisation');
                }
            } catch (error) {
                console.error('Erreur:', error);
                alert('Une erreur est survenue');
            }
        });
    </script>
{% endblock %}

